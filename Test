import javax.swing.*;
import java.awt.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

public class testUI extends JFrame {
    private JTextField jTextField1;
    private JTextField jTextField2;
    private JTextField jTextField3;
    private JComboBox<String> comboBox;
    private JLabel jLabel1, jLabel2, jLabel3, jLabel4;
    private JPanel jp1, jp2, jp3, jp4, jp5;
    private JButton jb1, jb2;

    public testUI() {
        setTitle("Credit Memo UI");
        setSize(500, 400);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        setLayout(new BorderLayout(10, 10));

        initComponents();

        setupLayout();

        addEventListeners();
    }

    private void initComponents() {
        jLabel1 = new JLabel("APID:");
        jLabel2 = new JLabel("Product Package ID:");
        jLabel3 = new JLabel("Language Preference:");
        jLabel4 = new JLabel("Narrative Sections:");

        jTextField1 = new JTextField(15);
        jTextField2 = new JTextField(15);
        jTextField3 = new JTextField(15);

        String[] options = {"Industry Risk", "Businesses Risk", "Financial Performance"};
        comboBox = new JComboBox<>(options);

        jb1 = new JButton("OK");
        jb2 = new JButton("Cancel");

        jp1 = new JPanel(new FlowLayout(FlowLayout.LEFT, 10, 5));
        jp2 = new JPanel(new FlowLayout(FlowLayout.LEFT, 10, 5));
        jp3 = new JPanel(new FlowLayout(FlowLayout.LEFT, 10, 5));
        jp4 = new JPanel(new FlowLayout(FlowLayout.LEFT, 10, 5));
        jp5 = new JPanel(new FlowLayout(FlowLayout.CENTER, 20, 5));
    }

    private void setupLayout() {
        jp1.setBorder(BorderFactory.createEmptyBorder(5, 20, 5, 20));
        jp2.setBorder(BorderFactory.createEmptyBorder(5, 20, 5, 20));
        jp3.setBorder(BorderFactory.createEmptyBorder(5, 20, 5, 20));
        jp4.setBorder(BorderFactory.createEmptyBorder(5, 20, 5, 20));

        jp1.add(jLabel1);
        jp1.add(jTextField1);

        jp2.add(jLabel2);
        jp2.add(jTextField2);

        jp3.add(jLabel3);
        jp3.add(jTextField3);

        jp4.add(jLabel4);
        jp4.add(comboBox);

        jp5.add(jb1);
        jp5.add(jb2);

        JPanel centerPanel = new JPanel(new GridLayout(4, 1, 5, 5));
        centerPanel.setBorder(BorderFactory.createEmptyBorder(20, 20, 20, 20));
        centerPanel.add(jp1);
        centerPanel.add(jp2);
        centerPanel.add(jp3);
        centerPanel.add(jp4);

        add(centerPanel, BorderLayout.CENTER);
        add(jp5, BorderLayout.SOUTH);
    }

    private void addEventListeners() {
        jb1.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                handleSubmit();
            }
        });

        jb2.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                handleReset();
            }
        });
    }

    private void handleSubmit() {
        String apid = jTextField1.getText();
        String packageID = jTextField2.getText();
        String language = jTextField3.getText();
        String sections = (String) comboBox.getSelectedItem();

        String message = String.format("Loading");
        JOptionPane.showMessageDialog(this, message, "Success", JOptionPane.INFORMATION_MESSAGE);
    }

    private void handleReset() {
        jTextField1.setText("");
        jTextField2.setText("");
        jTextField3.setText("");
        comboBox.setSelectedIndex(0);
        jTextField1.requestFocus();
    }

    public static void main(String[] args) {
        try {
            UIManager.setLookAndFeel(UIManager.getSystemLookAndFeelClassName());
        } catch (Exception e) {
            e.printStackTrace();
        }

        SwingUtilities.invokeLater(new Runnable() {
            @Override
            public void run() {
                new testUI().setVisible(true);
            }
        });
    }
}
